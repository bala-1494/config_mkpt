# ─────────────────────────────────────────────────────────────────────────────
# Root .env — docker compose reads this automatically.
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Base domain. PocketBase will be served at https://db.<DOMAIN_NAME>
DOMAIN_NAME=example.com

# Email used for Let's Encrypt registration and expiry notices
CERTBOT_EMAIL=admin@example.com

# PocketBase encryption key (generate with: openssl rand -hex 32)
PB_ENCRYPTION_KEY=change_me_32_char_hex_key

# Public PocketBase URL (used by frontend in prod)
POCKETBASE_PUBLIC_URL=https://db.example.com
