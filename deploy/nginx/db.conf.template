# Upgrade map — needed for PocketBase WebSocket / SSE realtime connections
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Serve the ACME challenge (certbot webroot renewal), redirect everything else
# to HTTPS.
server {
    listen 80;
    server_name db.${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ─────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2  on;
    server_name db.${DOMAIN_NAME};

    # Let's Encrypt certificates (populated by certbot)
    ssl_certificate     /etc/letsencrypt/live/db.${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/db.${DOMAIN_NAME}/privkey.pem;

    # Modern TLS-only settings
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # HSTS (6 months)
    add_header Strict-Transport-Security "max-age=15768000" always;

    # ── PocketBase proxy ──────────────────────────────────────────────────────
    location / {
        proxy_pass          http://backend:8090;

        proxy_set_header    Host              $host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;

        # WebSocket + SSE support — required for PocketBase realtime API
        proxy_http_version  1.1;
        proxy_set_header    Upgrade    $http_upgrade;
        proxy_set_header    Connection $connection_upgrade;

        # Do NOT buffer SSE streams
        proxy_buffering     off;
        proxy_read_timeout  3600s;

        # Increase body size limit for file uploads (adjust as needed)
        client_max_body_size 100M;
    }
}
