server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Serve React SPA — fallback all routes to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy PocketBase API — only used when running behind docker-compose.
    # On Cloud Run the frontend calls VITE_POCKETBASE_URL directly (baked at build).
    location /api/ {
        proxy_pass http://backend:8090/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
